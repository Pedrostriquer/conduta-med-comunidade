# Copie para server/.env. Valores pensados para o desenvolvimento local (README, "Como rodar localmente").
NODE_ENV=development
PORT=8300
DATABASE_URL=postgres://conduta:conduta@localhost:5544/conduta
# endereço público do app: entra nos links, no OAuth e no plugin
PUBLIC_URL=http://localhost:5180
# outros endereços que podem escrever na API, separados por vírgula (em produção, o do painel do admin)
EXTRA_ORIGINS=
# questoes.json, provas.json e o resto do banco (python3 exemplo/carregar.py preenche com os dados de exemplo)
DATA_DIR=../app/public/data
# opcionais: transcrições dos vídeos de correção e dados extras do banco (sem eles, essas partes ficam vazias)
TRANSCRIPTS_DIR=./data/transcricoes
BANK_EXTRA_FILE=./data/banco-extra.json
UPLOADS_DIR=./uploads
# segredo do token de confirmação do plugin: openssl rand -hex 32
CONFIRM_SECRET=
# cifra as chaves de API e a senha do e-mail guardadas no banco: openssl rand -hex 32. Trocar faz perder o que está guardado
SECRETS_KEY=
# quem entra com um destes e-mails vira admin (vê o painel do operador)
ADMIN_EMAILS=voce@exemplo.com.br
