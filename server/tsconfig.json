{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2023"],
    "strict": true, "noUncheckedIndexedAccess": false, "skipLibCheck": true, "noEmit": true,
    "esModuleInterop": true, "resolveJsonModule": true, "allowImportingTsExtensions": false,
    "types": ["node"]
  },
  "include": ["src", "test"]
}
