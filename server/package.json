{
  "name": "conduta-server",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js --packages=external --sourcemap",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx --env-file=.env src/migrate-cli.ts",
    "transcricoes": "tsx scripts/gerar-transcricoes.ts",
    "skills": "tsx scripts/gerar-skills.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@node-rs/argon2": "2.2.2",
    "heic-decode": "2.1.0",
    "hono": "4.13.14",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.15.6",
    "esbuild": "0.27.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
