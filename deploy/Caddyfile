# Conduta Med atras do Caddy. A plataforma (app, API e plugin) em plataforma.exemplo.com.br;
# Troque pelo seu dominio.

(conduta_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# domínio de testes por enquanto: fora dos buscadores
		X-Robots-Tag "noindex, nofollow"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com; font-src 'self'; media-src 'self' blob:; frame-src https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self'; worker-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
}

# a plataforma inteira; usada pelo endereço novo e pelo antigo
(conduta_app) {
	# API, OAuth, plugin e o guia para a IA ler (/ia.md, /llms.txt). flush_interval -1: o plugin pode responder em fluxo
	@api path /api/* /oauth/* /.well-known/* /mcp /mcp/* /ia.md /llms.txt
	handle @api {
		encode zstd gzip
		reverse_proxy 127.0.0.1:8300 {
			flush_interval -1
		}
	}

	# o banco só para quem tem conta: o índice (indice.json), o corpo das questões por prova (q/*) e o arquivo inteiro
	# (questoes.json, que o navegador não pede mais; quem lê é o servidor, direto do disco).
	# Também os assuntos (assuntos.json e assuntos/*, o resumo de cada um) e as resoluções das questões (resolucoes/*).
	# As figuras dos resumos (/img/assuntos/*) seguem abertas, como as outras imagens.
	# A tela de entrar usa /api/public/stats e a amostra (/data/amostra.json), que seguem abertas
	@banco path /data/questoes.json /data/indice.json /data/q/* /data/assuntos.json /data/assuntos/* /data/resolucoes/*
	handle @banco {
		forward_auth 127.0.0.1:8300 {
			uri /api/auth/check
		}
		root * /srv/conduta/web
		header Cache-Control "private, max-age=3600"
		file_server {
			precompressed br gzip
		}
	}

	handle /uploads/* {
		root * /srv/conduta
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /plugin/conduta-med.zip {
		root * /srv/conduta/web
		file_server
	}

	handle {
		root * /srv/conduta/web
		@imutavel path /assets/* /img/* /fonts/*
		header @imutavel Cache-Control "public, max-age=31536000, immutable"
		@pagina not path /assets/* /img/* /fonts/* /data/*
		header @pagina Cache-Control "no-cache"
		try_files {path} /index.html
		file_server {
			precompressed br gzip
		}
	}
}

plataforma.exemplo.com.br {
	import conduta_headers
	import conduta_app
}
