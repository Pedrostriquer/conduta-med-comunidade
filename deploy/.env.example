# Variáveis do docker-compose.yml em produção. Fica em .env ao lado do docker-compose.yml, no servidor.
# senha do Postgres: openssl rand -hex 24
DB_PASSWORD=
# endereço público do app (sem barra no fim)
PUBLIC_URL=https://plataforma.exemplo.com.br
# o painel do admin, que também escreve na API
EXTRA_ORIGINS=https://admin.exemplo.com.br
# openssl rand -hex 32
CONFIRM_SECRET=
# openssl rand -hex 32. Trocar faz perder as chaves guardadas no banco
SECRETS_KEY=
ADMIN_EMAILS=voce@exemplo.com.br
